# Opt-in only. Copy outside Git, read the security model, then change false to true.
HOMELAB_ENABLE_EXECUTION=false
HOMELAB_BROKER_MODE=local
HOMELAB_ALLOW_ROOT=false
HOMELAB_BROKER_SOCKET=/run/homelab-mcp/broker.sock
# Default allowed peer is broker's uid. For a separate root broker, set the
# frontend service account's numeric uid here; do not assume 1000.
# HOMELAB_ALLOWED_UID=1000
HOMELAB_AUDIT_PATH=/var/lib/homelab-mcp/audit/audit.jsonl
